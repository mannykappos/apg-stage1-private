+# a child script fragment: record this process's identity (pid and start time) in a file
+P2_REC = ('import os\n'
+          'def rec(path):\n'
+          '    d = open("/proc/self/stat").read(); s = d[d.rindex(")") + 2:].split()[19]\n'
+          '    open(path, "a").write("%d %s\\n" % (os.getpid(), s))\n')
+
