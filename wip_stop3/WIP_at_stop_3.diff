+def p2_descendants(pid):
+    """Every live descendant of pid: (pid, start, cwd)."""
+    tab = E.proc_table()
+    kids = {}
+    for p, (st, pp, s) in tab.items():
+        kids.setdefault(pp, []).append(p)
+    out, todo = [], [pid]
+    while todo:
+        x = todo.pop()
+        for c in kids.get(x, ()):
+            try:
+                cwd = os.readlink('/proc/%d/cwd' % c)
+            except OSError:
+                cwd = ''
+            if tab[c][0] != 'Z':
+                out.append((c, tab[c][2], cwd))
+            todo.append(c)
