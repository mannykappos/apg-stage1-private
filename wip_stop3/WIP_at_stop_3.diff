+    def test_forking_needs_a_single_thread(self):
+        ev = _thr.Event()
+        th = _thr.Thread(target=ev.wait)
+        th.start()
+        try:
+            with self.assertRaises(E.RunError) as c:
+                self.run_f(lambda: {'failed': []})
+            self.assertEqual(c.exception.code, 'ENV_THREADS_AT_FORK')
+        finally:
+            ev.set()
