+                  '        open(cf, "a").write("x")\n        where = "control_start" if len(open(cf).read()) == 1 else "control_end"\n'
+                  '    return _p2_behaviour(where, lambda: {r[1] for r in R.run(factory) if not r[3]})\n' % root)]
